{
  "name": "mcp-preview-contract",
  "version": "0.1.0",
  "description": "Disposable-fixture contract checks for preview-bound MCP writes, with independent state and mutation oracles",
  "type": "module",
  "private": true,
  "license": "MIT",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": { ".": { "types": "./src/index.d.ts", "import": "./src/index.mjs" } },
  "bin": { "mcp-preview-contract": "./bin/mcp-preview-contract.mjs" },
  "files": ["src", "bin", "examples", "test", "README.md", "LICENSE", "PROVENANCE.md", "THIRD_PARTY_NOTICES.md"],
  "scripts": {
    "test": "node --test test/core.test.mjs test/integration.test.mjs",
    "demo": "node bin/mcp-preview-contract.mjs demo",
    "check": "node --check src/index.mjs && node --check bin/mcp-preview-contract.mjs"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "@modelcontextprotocol/sdk": "1.32.1", "zod": "3.25.76" }
}
